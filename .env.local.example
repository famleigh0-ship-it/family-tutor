# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Exposed to the frontend (Vite only exposes vars prefixed with VITE_).
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-side only (used by api/ serverless functions). Do NOT prefix with VITE_
# or these will be bundled into the client and publicly exposed.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# Deployed site origin — used by src/lib/triggerBankFill.js to POST to
# /api/bank/fill from Node scripts and from api/bank/serve.js's async fill
# trigger. No scheme-less shortcuts; include https://.
APP_BASE_URL=https://your-deployed-app.vercel.app
