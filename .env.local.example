# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Exposed to the frontend (Vite only exposes vars prefixed with VITE_).
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-side only (used by api/ serverless functions). Do NOT prefix with VITE_
# or these will be bundled into the client and publicly exposed.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
ANTHROPIC_API_KEY=your_anthropic_api_key
