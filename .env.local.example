# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Exposed to the frontend (Vite only exposes vars prefixed with VITE_).
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-side only (used by api/ serverless functions). Do NOT prefix with VITE_
# or these will be bundled into the client and publicly exposed.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# Shared secret for the daily-maintenance cron job (api/progress/index.js,
# type=daily-maintenance). Vercel automatically sends this as an
# `Authorization: Bearer <CRON_SECRET>` header on its own cron requests once
# this var is set in the project's environment variables — generate any
# random string locally and set the same value in the Vercel dashboard
# (Project Settings -> Environment Variables) for it to work in production.
CRON_SECRET=your_cron_secret
